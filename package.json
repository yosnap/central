{
  "name": "central",
  "version": "0.3.1",
  "private": true,
  "description": "Central — CRM personal de Paulo (iServisat): clientes, proyectos, webs, presupuestos, agenda y correo.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3099",
    "build": "bunx prisma generate && bun --bun next build",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "scan": "bun scripts/scan.ts",
    "uptime": "bun scripts/uptime.ts",
    "servidores": "bun scripts/servidores.ts",
    "repos:sync": "bun scripts/repos-sync.ts",
    "tarea:horaria": "bun scripts/scan.ts --fetch-active && bun scripts/repos-sync.ts --active",
    "tareas:instalar": "scripts/tareas-mac.sh instalar",
    "tareas:quitar": "scripts/tareas-mac.sh quitar",
    "tareas:estado": "scripts/tareas-mac.sh estado",
    "websites:import": "bun scripts/import-websites.ts",
    "videos:sync": "bun scripts/sync-videos.ts",
    "mcp": "bun src/mcp/server.ts",
    "trabajador": "bun scripts/trabajador.ts",
    "trabajador:instalar": "bash scripts/trabajador-mac.sh instalar",
    "trabajador:quitar": "bash scripts/trabajador-mac.sh quitar",
    "trabajador:estado": "bash scripts/trabajador-mac.sh estado",
    "produccion:variables": "bun scripts/produccion-variables.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "cmdk": "^1.1.1",
    "docx": "^9.14.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "simple-icons": "16.36.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "ssh2": "1.16.0",
    "yaml": "2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "dotenv": "^16.4.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  }
}
