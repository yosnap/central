# Base de datos (docker compose levanta Postgres en el 5433)
DATABASE_URL="postgresql://central:central@localhost:5433/central"

# Acceso a la app (monousuario). Cámbialo.
CENTRAL_PASSWORD="cambia-esto"
# Secreto para firmar la cookie de sesión (cadena larga aleatoria)
CENTRAL_SESSION_SECRET="genera-una-cadena-larga-aleatoria"

# Token para el endpoint de cron de uptime (/api/cron/uptime?token=...)
CRON_TOKEN="otra-cadena-aleatoria"
# Token de solo lectura para otras apps (CostGuard lee /api/servidores con Authorization: Bearer)
CENTRAL_API_TOKEN="otra-cadena-aleatoria-mas"

# Carpetas que el escáner recorre por defecto (separadas por ;)
SCAN_ROOTS="/ruta/a/tus/proyectos"

# Almacenamiento S3 (SeaweedFS local, servicio "storage" de docker compose)
S3_ENDPOINT="http://localhost:8334"
S3_REGION="us-east-1"
S3_BUCKET="central"
S3_ACCESS_KEY="central"
S3_SECRET_KEY="central-secret"
S3_PUBLIC_URL="http://localhost:8334/central"

# Portfolio sn4p.dev
SN4P_API_URL="https://sn4p.dev"
SN4P_USERNAME=""
SN4P_PASSWORD=""

# Cifrado de tokens de integraciones (32 bytes en base64: openssl rand -base64 32)
CENTRAL_ENCRYPTION_KEY=""
